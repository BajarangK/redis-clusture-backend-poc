# --- Run on host (node server.js) ---
PORT=5004
REDIS_MODE=cluster
REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003
# Maps Docker internal IPs (172.x) to localhost published ports
REDIS_CLUSTER_NAT_HOST=127.0.0.1

# --- Run in Docker (docker compose up) ---
# Uses redis-node-* on network redis-enterprise-cluster_redis-cluster-net
# No NAT host needed; app on host port 5004 (HOST_PORT=5004)
