PORT=5004
REDIS_MODE=cluster

# QA Windows — port-forward only (no Redis cluster config change)
# kubectl port-forward -n redis-cluster svc/redis-cluster 6379:6379
REDIS_CLUSTER_NODES=127.0.0.1:6379
REDIS_CLUSTER_NAT_HOST=127.0.0.1

# QA inside K8s — use headless DNS, omit NAT_HOST
# REDIS_CLUSTER_NODES=redis-cluster-0.redis-headless.redis-cluster.svc.cluster.local:6379,...

# REDIS_PASSWORD=
